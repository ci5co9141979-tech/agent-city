  "calc_breakeven": {
   "category": "AI Micro Apps",
   "name": "BreakEven - Digital Product Price & Profit Calculator",
   "module": "calc_app",
   "family": "micro_app",
   "price": 47,
   "buyer": "creators selling templates, courses and downloads who need to price for profit",
   "angle": "See net per sale after platform and payment fees, break-even units and return on ad spend.",
   "keywords": [
    "digital product pricing",
    "break even calculator",
    "creator profit calculator",
    "gumroad fees",
    "course pricing"
   ],
   "spec": {
    "title": "BreakEven",
    "tagline": "Price your digital product so it actually pays.",
    "notes": "Platform and payment fees vary and change. Replace the example percentages with your platform's current fees.",
    "inputs": [
     {
      "id": "price",
      "label": "Product price",
      "value": 29,
      "prefix": "$",
      "step": 0.01
     },
     {
      "id": "plat",
      "label": "Platform fee %",
      "value": 5,
      "suffix": "%",
      "step": 0.1
     },
     {
      "id": "pay",
      "label": "Payment processing %",
      "value": 2.9,
      "suffix": "%",
      "step": 0.1
     },
     {
      "id": "pay_fixed",
      "label": "Payment fixed fee",
      "value": 0.3,
      "prefix": "$",
      "step": 0.01
     },
     {
      "id": "fixed",
      "label": "Tools / software costs (one-time or monthly)",
      "value": 120,
      "prefix": "$",
      "step": 1
     },
     {
      "id": "ads",
      "label": "Ad spend",
      "value": 100,
      "prefix": "$",
      "step": 1
     },
     {
      "id": "units",
      "label": "Units sold",
      "value": 40,
      "step": 1
     },
     {
      "id": "refund",
      "label": "Refund rate %",
      "value": 3,
      "suffix": "%",
      "step": 0.1
     }
    ],
    "vars": [
     {
      "id": "net",
      "expr": "price * (1 - (plat + pay) / 100) - pay_fixed"
     },
     {
      "id": "kept",
      "expr": "units * (1 - refund / 100)"
     }
    ],
    "outputs": [
     {
      "label": "Net per sale (after fees)",
      "expr": "net",
      "fmt": "money"
     },
     {
      "label": "Profit",
      "expr": "net * kept - fixed - ads",
      "fmt": "money",
      "big": true
     },
     {
      "label": "Break-even units",
      "expr": "net > 0 ? Math.ceil((fixed + ads) / (net * (1 - refund / 100))) : 0",
      "fmt": "int"
     },
     {
      "label": "Return on ad spend (x)",
      "expr": "ads > 0 ? net * kept / ads : 0",
      "fmt": "num"
     },
     {
      "label": "Revenue after refunds",
      "expr": "price * kept",
      "fmt": "money"
     }
    ]
   },
   "kind": "calc",
   "deliverables": [
    "Single-file calculator app (works offline in any browser)",
    "README with setup notes"
   ],
   "license": "Use for your own business. No resale or redistribution of the app."
  }
