 "entries": {
  "calc_listingprofit": {
   "category": "AI Micro Apps",
   "name": "ListingProfit - Marketplace Fee & Profit Calculator",
   "module": "calc_app",
   "family": "micro_app",
   "price": 47,
   "buyer": "Etsy, eBay and online-shop sellers who don't know their real profit per sale",
   "angle": "Enter price, costs and fees; see profit per sale, margin, monthly profit and the break-even price.",
   "keywords": [
    "etsy fee calculator",
    "profit margin calculator",
    "seller profit calculator",
    "break even price",
    "online shop pricing"
   ],
   "spec": {
    "title": "ListingProfit",
    "tagline": "Know your real profit per sale before you set the price.",
    "notes": "Fee rates change and differ by platform and country. Edit the fee fields to match your platform's current published fees.",
    "inputs": [
     {
      "id": "price",
      "label": "Item price",
      "value": 28,
      "prefix": "$",
      "step": 0.01
     },
     {
      "id": "ship_in",
      "label": "Shipping charged to buyer",
      "value": 4,
      "prefix": "$",
      "step": 0.01
     },
     {
      "id": "cogs",
      "label": "Cost to make / buy the item",
      "value": 7,
      "prefix": "$",
      "step": 0.01
     },
     {
      "id": "ship_out",
      "label": "Your actual shipping + packaging cost",
      "value": 4.5,
      "prefix": "$",
      "step": 0.01
     },
     {
      "id": "fee_pct",
      "label": "Marketplace fee (% of sale + shipping)",
      "value": 6.5,
      "suffix": "%",
      "step": 0.1
     },
     {
      "id": "pay_pct",
      "label": "Payment processing %",
      "value": 3,
      "suffix": "%",
      "step": 0.1
     },
     {
      "id": "pay_fixed",
      "label": "Payment processing fixed fee",
      "value": 0.25,
      "prefix": "$",
      "step": 0.01
     },
     {
      "id": "list_fee",
      "label": "Listing fee per sale",
      "value": 0.2,
      "prefix": "$",
      "step": 0.01
     },
     {
      "id": "ad_pct",
      "label": "Advertising (% of price)",
      "value": 0,
      "suffix": "%",
      "step": 0.1
     },
     {
      "id": "units",
      "label": "Sales per month",
      "value": 60,
      "step": 1
     }
    ],
    "vars": [
     {
      "id": "revenue",
      "expr": "price + ship_in"
     },
     {
      "id": "f",
      "expr": "(fee_pct + pay_pct) / 100"
     },
     {
      "id": "fees",
      "expr": "revenue * f + pay_fixed + list_fee"
     },
     {
      "id": "ads",
      "expr": "price * ad_pct / 100"
     },
     {
      "id": "profit",
      "expr": "revenue - fees - ads - cogs - ship_out"
     }
    ],
    "outputs": [
     {
      "label": "Total fees per sale",
      "expr": "fees",
      "fmt": "money"
     },
     {
      "label": "Profit per sale",
      "expr": "profit",
      "fmt": "money",
      "big": true
     },
     {
      "label": "Profit margin (of price)",
      "expr": "price > 0 ? profit / price * 100 : 0",
      "fmt": "pct"
     },
     {
      "label": "Monthly profit",
      "expr": "profit * units",
      "fmt": "money"
     },
     {
      "label": "Break-even price",
      "expr": "(cogs + ship_out + pay_fixed + list_fee - ship_in * (1 - f)) / (1 - f - ad_pct / 100)",
      "fmt": "money"
     }
    ]
   },
   "kind": "calc",
   "deliverables": [
    "Single-file calculator app (works offline in any browser)",
    "README with setup notes"
   ],
   "license": "Use for your own business. No resale or redistribution of the app."
  },
